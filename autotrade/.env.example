# ===== 운용 모드 =====
DRY_RUN=True                    # True=모의투자, False=실전투자
MAX_POSITION_RATIO=0.5          # 총 자산 대비 최대 투자 비율
DAILY_LOSS_LIMIT=-0.03          # 일일 손실 한도 (-3%)
MAX_SLOTS=5                     # 동시 보유 최대 종목 수

# ===== 증권사 API =====
KIS_APP_KEY=발급받은_앱키
KIS_APP_SECRET=발급받은_시크릿
KIS_ACCOUNT_NO=계좌번호-01      # 예: 50123456-01
KIS_MODE=paper                  # paper=모의투자, real=실전

# ===== 데이터 API =====
DART_API_KEY=발급받은_DART_키
TAVILY_API_KEY=발급받은_TAVILY_키

# ===== AI 모델 =====
ANTHROPIC_API_KEY=발급받은_CLAUDE_키
AI_MONITOR_MODEL=ollama/gemma4          # 모니터링용 (무료)
AI_ANALYSIS_MODEL=claude-haiku-4-5-20251001  # 분석용 (소량 유료)
AI_MONTHLY_MODEL=claude-sonnet-4-6           # 월간 최적화용

# ===== 텔레그램 =====
